---
import Icon from './site/Icon.astro';
// Navy quote band with the enquiry form (posts to /api/contact). Non-UPS families pass their own field labels.
const { title, service, pitch, step1, field, ask } = Astro.props;
const ups = !field;
---
<section class="pd-sec pd-qsec" id="quote" aria-labelledby="h-quote">
	<div class="container">
		<div class="pd-wrap pd-quote">
			<div class="pd-qinfo">
				<span class="pd-qtag">Free sizing &amp; quotation</span>
				<h2 id="h-quote">{title}</h2>
				<p>{pitch ?? 'Tell us the load and backup time. An engineer sizes the right model and sends a quotation.'}</p>
				<ol class="pd-steps">
					<li><b>1</b><span>{step1 ?? 'Share your load, backup time and site city'}</span></li>
					<li><b>2</b><span>An engineer calls to confirm the sizing</span></li>
					<li><b>3</b><span>Quotation usually within one working day</span></li>
				</ol>
				<div class="pd-qcontact">
					<a href="tel:+918028371974"><Icon name="fa-phone" class="ic" /><span><small>Call sales</small>080 2837 1974</span></a>
					<a href="mailto:sales@eandcpower.com"><Icon name="fa-envelope" class="ic" /><span><small>Email</small>sales@eandcpower.com</span></a>
				</div>
			</div>
			<form class="pd-form" action="/api/contact" method="POST" data-enquiry>
				<p class="pd-form-h">Request a quote</p>
				<input type="hidden" name="service" value={service} />
				<div class="pd-fields">
					<div><label for="q-name">Name <i aria-hidden="true">*</i></label><input id="q-name" name="name" required autocomplete="name" /></div>
					<div><label for="q-phone">Phone <i aria-hidden="true">*</i></label><input id="q-phone" type="tel" name="phone" required autocomplete="tel" inputmode="tel" /></div>
					<div><label for="q-email">Email <i aria-hidden="true">*</i></label><input id="q-email" type="email" name="email" required autocomplete="email" inputmode="email" /></div>
					<div><label for="q-city">City <i aria-hidden="true">*</i></label><input id="q-city" name="city" required autocomplete="address-level2" /></div>
					<div><label for="q-company">Company</label><input id="q-company" name="company" autocomplete="organization" /></div>
					<div><label for="q-kva">{field ?? 'Capacity needed (kVA)'}</label><input id="q-kva" name="capacity" inputmode={ups ? 'decimal' : undefined} placeholder={ups ? 'e.g. 20' : undefined} /></div>
					<div class="full"><label for="q-msg">{ask ?? 'What will it power? Backup time?'} <i aria-hidden="true">*</i></label><textarea id="q-msg" name="message" rows="3" required placeholder={ups ? 'e.g. 10 servers and network, 30 minutes backup' : undefined}></textarea></div>
				</div>
				<button type="submit" class="pd-btn pd-btn-main pd-submit">Get my quote <Icon name="fa-arrow-right" class="ic" /></button>
				<p class="pd-note"><Icon name="fa-shield" class="ic" />Your details are used only to prepare this quotation.</p>
			</form>
		</div>
	</div>
</section>
