---
// The homepage's "Some Prestigious Customers" logos, reused as a trust strip.
import { customers as logos } from '../data/customers.js';
---
<section class="pd-sec" aria-labelledby="h-cust">
	<div class="container">
		<h2 class="pd-h" id="h-cust">Some of our customers</h2>
		<ul class="hb-logos">{logos.map(([f, n]) => <li><img src={`/image/${f}`} alt={n} width="95" height="65" loading="lazy" /></li>)}</ul>
	</div>
</section>
