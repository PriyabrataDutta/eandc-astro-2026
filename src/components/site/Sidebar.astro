---
// Sidebar for long pages (Page.astro): quick enquiry form, featured products and the Peenya address. The form posts to
// /api/contact through /js/enquiry.js (Base loads it when a page sets `enquiry`).
import { PHONE, SALES_PHONE, EMAIL } from '../../data/nav.js';

const featured = [
  ['Accenta online UPS, 1 to 10 kVA', '/accenta'],
  ['Renata-I UPS, 2 to 30 kVA', '/renata'],
  ['Renata-300, 10 to 800 kVA', '/renata300'],
  ['Renata Modular, 10 to 1200 kVA', '/renatamodular'],
  ['MIL grade industrial UPS', '/mil-grade'],
  ['Industrial battery chargers (FCBC)', '/industrial-battery-charger-fcbc'],
  ['Oil cooled servo stabilizers', '/oil-cooled'],
  ['AC and DC EV chargers', '/ev-chargers'],
];
const field = 'block w-full min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-[15px] text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20';
const box = 'rounded-xl border border-slate-200 bg-white p-6';
const h = 'font-display text-lg font-semibold text-navy-900';
---
<aside class="flex flex-col gap-6" aria-label="Enquiry and featured products">
  <section class={box} aria-labelledby="sb-enq">
    <h2 id="sb-enq" class={h}>Quick enquiry</h2>
    <p class="mt-1 text-sm text-slate-600">Get in touch with our power electronics engineering team.</p>
    <form action="/api/contact" method="POST" data-enquiry class="mt-4 grid gap-3">
      <label class="sr-only" for="sb-name">Your name</label><input id="sb-name" name="name" required autocomplete="name" placeholder="Your name" class={field} />
      <label class="sr-only" for="sb-email">Email</label><input id="sb-email" type="email" name="email" required autocomplete="email" placeholder="Email address" class={field} />
      <label class="sr-only" for="sb-phone">Phone</label><input id="sb-phone" type="tel" name="phone" required autocomplete="tel" inputmode="tel" placeholder="Phone number" class={field} />
      <label class="sr-only" for="sb-msg">Requirement</label><textarea id="sb-msg" name="message" rows="3" required placeholder="Power requirement or capacity (kVA)" class={`${field} py-2.5`}></textarea>
      <button type="submit" class="btn-solid h-11 w-full px-4 text-sm">Submit enquiry</button>
    </form>
  </section>

  <section class={box} aria-labelledby="sb-prod">
    <h2 id="sb-prod" class={h}>Featured products</h2>
    <ul class="mt-3 divide-y divide-slate-100 text-[15px]">
      {featured.map(([l, u]) => <li><a href={u} class="block py-2 text-slate-700 hover:text-brand-700">{l}</a></li>)}
    </ul>
  </section>

  <section class="rounded-xl bg-slate-50 p-6 text-sm leading-relaxed text-slate-700" aria-labelledby="sb-hub">
    <h2 id="sb-hub" class="font-display text-base font-semibold text-navy-900">E&amp;C manufacturing hub</h2>
    <p class="mt-2"><strong class="text-slate-900">Electronics &amp; Controls Power Systems Pvt. Ltd.</strong><br />29/A, 2nd Phase, Peenya Industrial Area,<br />Bengaluru, Karnataka 560058<br />CIN U31200KA1997PTC022448</p>
    <p class="mt-2">Phone <a href={`tel:${PHONE.tel}`} class="text-brand-700 hover:underline">{PHONE.label}</a>, <a href={`tel:${SALES_PHONE.tel}`} class="text-brand-700 hover:underline">{SALES_PHONE.label}</a><br />Email <a href={`mailto:${EMAIL}`} class="text-brand-700 hover:underline">{EMAIL}</a></p>
  </section>
</aside>
