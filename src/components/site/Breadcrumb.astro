---
// Breadcrumb strip under the header: `trail` is [{ name, url }] from Home down; `current` is this page's name.
const { trail = [], current } = Astro.props;
---
<nav aria-label="Breadcrumb" class="border-b border-slate-200 bg-slate-50">
  <ol class="container flex flex-wrap items-center gap-x-2 gap-y-1 py-3 text-[13px]">
    {trail.map((c) => (
      <li class="flex items-center gap-2"><a href={c.url} class="text-brand-700 hover:underline">{c.name}</a><span class="text-slate-400" aria-hidden="true">/</span></li>
    ))}
    <li aria-current="page" class="text-slate-600">{current}</li>
  </ol>
</nav>
