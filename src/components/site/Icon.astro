const FA = {
  industry: 'factory', bolt: 'zap', cogs: 'cog', 'map-marker': 'pin', 'sun-o': 'sun', 'line-chart': 'chart-line', random: 'shuffle',
  home: 'house', 'hospital-o': 'hospital', th: 'layout-grid', 'thermometer-three-quarters': 'thermometer', 'arrow-right': 'arrow',
  microchip: 'cpu', 'handshake-o': 'handshake', sliders: 'sliders-horizontal', road: 'route', 'snowflake-o': 'snowflake', clone: 'copy',
  arrows: 'move', university: 'landmark', exchange: 'arrow-left-right', 'fighter-jet': 'plane', tachometer: 'gauge', fire: 'flame',
  tint: 'droplet', cubes: 'boxes', cutlery: 'utensils', desktop: 'monitor', 'clock-o': 'clock', certificate: 'award', compress: 'shrink',
  'building-o': 'building', building: 'building-2', 'video-camera': 'video', tree: 'tree-pine', print: 'printer',
  'battery-three-quarters': 'battery-medium', 'check-circle': 'circle-check', envelope: 'mail', medkit: 'briefcase-medical',
};
const { name, class: cls = 'size-5' } = Astro.props;
const key = name.replace(/^fa-/, '');
const svg = P[FA[key] ?? key];
if (!svg) throw new Error(`Icon "${name}" is not in Icon.astro`);
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg} />
