---
// The document head for every Astro page: title, description, canonical, robots, Open Graph, schema and analytics.
// `slug` is the page path without slashes ('index' for the home page); `image` is a site path or an absolute URL.
import { SITE, urlFor } from '../../lib/site.js';

const { title, description, slug, image = '/image/logo2.png', type = 'website', published, schema = [], noindex = false } = Astro.props;
const url = urlFor(slug);
const imageUrl = /^https?:/.test(image) ? image : SITE + image;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href="/image/favicon.png" type="image/png" sizes="16x16" />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={type} />
{published && <meta property="article:published_time" content={published} />}
<meta property="og:site_name" content="E&C Power Systems" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
{schema.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H6MP2261FR"></script>
<script is:inline>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-H6MP2261FR');</script>
