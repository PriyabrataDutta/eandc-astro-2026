---
// Redesigned footer: company and contact, products, industries, company links and the India / city pages.
import Icon from './Icon.astro';
import { industries, PHONE, SALES_PHONE, EMAIL } from '../../data/nav.js';

const cols = [
  ['Products', [['Online UPS', '/online-ups'], ['Industrial UPS', '/industrial-ups-manufacturer-in-india'], ['Modular UPS', '/renatamodular'], ['Inverters', '/power-inverter-manufacturer-in-india'], ['Voltage stabilizers', '/stabilizer'], ['UPS batteries', '/ups-batteries'], ['Solar solutions', '/solar-solutions'], ['EV chargers', '/ev-charger-manufacturer-in-india'], ['Remote monitoring', '/remote-monitoring-system']]],
  ['Industries', industries.slice(0, 7).map(([l, u]) => [l, u])],
  ['Company', [['About us', '/about-us'], ['Service and AMC', '/eandcpower-services'], ['Blog and guides', '/blogs'], ['Catalogs', '/catalog'], ['FAQs', '/frequently-asked-questions'], ['Careers', '/careers'], ['Contact', '/contact']]],
  ['UPS across India', [['UPS manufacturer in India', '/ups-manufacturer-in-india'], ['Bengaluru', '/ups-manufacturer-in-bangalore'], ['Mumbai', '/ups-manufacturer-in-mumbai'], ['Delhi', '/ups-manufacturer-in-delhi'], ['Chennai', '/ups-manufacturer-in-chennai'], ['Hyderabad', '/ups-manufacturer-in-hyderabad'], ['Kolkata', '/ups-manufacturer-in-kolkata'], ['Sales offices', '/contact#sales-offices']]],
];
const social = [['linkedin', 'https://www.linkedin.com/company/electronics-controls-power-systems-pvt-ltd/', 'LinkedIn'], ['facebook', 'https://www.facebook.com/eandcpower', 'Facebook'], ['twitter', 'https://twitter.com/eandcpower', 'X (Twitter)']];
---
<footer class="bg-navy-950 text-sm text-slate-300">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-10 py-14 lg:grid-cols-[1.6fr_repeat(4,1fr)] lg:gap-8">
    <div class="col-span-2 lg:col-span-1">
      <img src="/image/logo4.png" alt="E&C Power Systems logo" width="192" height="86" class="h-14 w-auto" loading="lazy" />
      <p class="mt-4 max-w-xs leading-relaxed text-slate-400">Indian manufacturer of online UPS and power electronics since 1978, with sales and service across India.</p>
      <address class="mt-5 space-y-2.5 not-italic">
        <p class="flex gap-2.5"><Icon name="pin" class="mt-0.5 size-4 shrink-0 text-brand-400" />29/A, 2nd Phase, Peenya Industrial Area, Bengaluru, Karnataka 560058</p>
        <p class="flex gap-2.5"><Icon name="phone" class="mt-0.5 size-4 shrink-0 text-brand-400" /><span>Office <a class="whitespace-nowrap text-white hover:text-brand-300" href={`tel:${PHONE.tel}`}>{PHONE.label}</a> · Sales <a class="whitespace-nowrap text-white hover:text-brand-300" href={`tel:${SALES_PHONE.tel}`}>{SALES_PHONE.label}</a></span></p>
        <p class="flex gap-2.5"><Icon name="mail" class="mt-0.5 size-4 shrink-0 text-brand-400" /><a class="text-white hover:text-brand-300" href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        <p class="flex gap-2.5"><Icon name="clock" class="mt-0.5 size-4 shrink-0 text-brand-400" />Mon to Sat, 9:00 am to 5:30 pm</p>
      </address>
      <div class="mt-5 flex gap-2">
        {social.map(([i, u, n]) => <a href={u} rel="noopener" target="_blank" aria-label={n} class="flex size-10 items-center justify-center rounded-lg border border-white/10 hover:border-brand-400 hover:text-white"><Icon name={i} class="size-4" /></a>)}
      </div>
    </div>
    {cols.map(([h, items]) => (
      <div>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-white">{h}</h2>
        <ul class="space-y-2.5">{items.map(([l, u]) => <li><a class="hover:text-white" href={u}>{l}</a></li>)}</ul>
      </div>
    ))}
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-5 text-xs text-slate-400 md:flex-row md:justify-between">
      <p>© {new Date().getFullYear()} Electronics &amp; Controls Power Systems Pvt. Ltd. · CIN U31200KA1997PTC022448</p>
      <p class="flex gap-4"><a class="hover:text-white" href="/annualreturn">Annual return</a><a class="hover:text-white" href="/sitemap">Sitemap</a><a class="hover:text-white" href="https://www.appaddindia.net/" rel="noopener">Powered by Appadd India</a></p>
    </div>
  </div>
</footer>
