---
// India hub, state, city, category and industrial pages: Base (head, header, footer, Tailwind) with the product-page
// parts (pd-*, hb-* in pd.css and hub.css). Each page writes its own hero and sections in the slot.
import Base from './Base.astro';
import Breadcrumb from '../components/site/Breadcrumb.astro';
import Icon from '../components/site/Icon.astro';
import { urlFor } from '../lib/site.js';

const { slug, title, description, name, crumbs = [], schema = [], noindex = false, image = '/image/about.jpg', quote = true } = Astro.props;
const trail = [{ name: 'Home', url: '/' }, ...crumbs];
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [...trail, { name, url: `/${slug}` }].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: urlFor('index').slice(0, -1) + c.url })),
  },
  ...schema,
];
---
<Base slug={slug} title={title} description={description} image={image} schema={ld} noindex={noindex} bodyClass="has-pd-bar" enquiry>
  <Breadcrumb trail={trail} current={name} />
  <div class="pd">
    <slot />
    <div class="pd-bar">
      <a class="pd-btn pd-btn-line" href="tel:+918028371974"><Icon name="phone" class="ic" />Call</a>
      <a class="pd-btn pd-btn-main" href={quote ? '#quote' : '/get-a-quote'}>Get a price</a>
    </div>
  </div>
</Base>
