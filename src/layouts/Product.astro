---
// Product page: Base (head, header, footer, Tailwind) with a compact, mobile-first product layout from products.js.
// Flat style, visible form labels, 44px tap targets, stacked spec table on phones.
import Base from './Base.astro';
import Breadcrumb from '../components/site/Breadcrumb.astro';
import Icon from '../components/site/Icon.astro';
import { urlFor, ORG_REF } from '../lib/site.js';
import { products, families, guideTitles } from '../data/products.js';
import { posts } from '../lib/blog.js';
import Quote from '../components/Quote.astro';
import Faq from '../components/Faq.astro';
import { productFaq } from '../data/product-faq.js';

const { slug } = Astro.props;
const raw = products[slug];
const fam = families[raw.family];
const asItem = (x, icon) => (typeof x === 'string' ? { icon, title: x, text: x } : x);
const p = {
  ...raw,
  family: fam,
  title: raw.title,
  description: raw.description,
  overview: raw.overview ?? [],
  specs: raw.specs ?? [],
  highlights: raw.highlights ?? [],
  features: raw.features.map((f) => (typeof f === 'string' ? { icon: 'fa-check', title: f } : f)),
  applications: raw.applications.map((a) => asItem(a, 'fa-check-circle')),
  guides: raw.guides ?? fam.guides,
  related: raw.related ?? Object.keys(products).filter((k) => k !== slug && products[k].family === raw.family).slice(0, 4),
};
const ups = !fam.field;
const faq = raw.faq ?? productFaq[slug] ?? [];
const reads = posts.filter((x) => x.products?.includes(slug));

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description: p.description,
    ...(p.image && { image: urlFor('index').slice(0, -1) + p.image }),
    category: p.family.name,
    brand: { '@type': 'Brand', name: 'E&C Power Systems' },
    manufacturer: ORG_REF,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: urlFor('index') },
      ...(p.family.url ? [{ '@type': 'ListItem', name: p.family.name, item: urlFor(p.family.url.slice(1)) }] : []),
      { '@type': 'ListItem', name: p.name, item: urlFor(slug) },
    ].map((c, i) => ({ ...c, position: i + 1 })),
  },
  ...(faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base slug={slug} title={p.title} description={p.description} image={p.image ?? '/image/logo2.png'} schema={ld} bodyClass="has-pd-bar" enquiry>
	<Breadcrumb trail={[{ name: 'Home', url: '/' }, ...(p.family.url ? [{ name: p.family.name, url: p.family.url }] : [])]} current={p.name} />
	<div class="pd">
		<section class="pd-hero">
			<div class="container">
				<div class={`pd-wrap${p.image ? '' : ' pd-noimg'}`}>
					<div>
						<span class="pd-eyebrow">{p.family.name}</span>
						<h1>{p.heading ?? p.name}</h1>
						<p class="pd-tagline">{p.tagline}</p>
						{p.capacity && <div class="pd-cap"><small>{ups ? 'Capacity' : 'Range'}</small><strong>{p.capacity}</strong></div>}
						{p.highlights.length > 0 && <ul class="pd-chips">{p.highlights.map((h) => <li><Icon name={h.icon} class="ic" />{h.text}</li>)}</ul>}
						<div class="pd-ctas">
							<a class="pd-btn pd-btn-main" href="#quote">Get a price</a>
							<a class="pd-btn pd-btn-line" href="tel:+918028371974"><Icon name="fa-phone" class="ic" />080 2837 1974</a>
						</div>
					</div>
					{p.image && <div class="pd-img"><img src={p.image} alt={p.name} width="420" height="360" fetchpriority="high" /></div>}
				</div>
			</div>
		</section>

		<div class="container">
			<ul class="pd-trust">
				<li><Icon name="fa-check" class="ic" />40+ years in power electronics</li>
				<li><Icon name="fa-industry" class="ic" />Designed and built in Peenya, Bengaluru</li>
				<li><Icon name="fa-cogs" class="ic" />Installation, AMC and service</li>
			</ul>
		</div>

		<section class="pd-sec" aria-labelledby="h-features">
			<div class="container">
				<h2 class="pd-h" id="h-features">Key features</h2>
				<div class="pd-feats">
					{p.features.map((f) => (
						<div class={`pd-feat${f.text ? '' : ' mini'}`}><Icon name={f.icon} class="ic" /><div><h3>{f.title}</h3>{f.text && <p>{f.text}</p>}</div></div>
					))}
				</div>
			</div>
		</section>

		<section class="pd-sec alt" aria-labelledby="h-specs">
			<div class="container">
				<div class={`pd-wrap${p.specs.length ? ' pd-two' : ''}`}>
					{p.specs.length > 0 && (
						<div>
							<h2 class="pd-h" id="h-specs">Technical specifications</h2>
							<table class="pd-spec"><tbody>{p.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table>
						</div>
					)}
					<div class="pd-side">
						{p.overview.length > 0 && <h2 class="pd-h" id={p.specs.length ? undefined : 'h-specs'}>Overview</h2>}
						{p.overview.map((t) => <p>{t}</p>)}
						<h2 class="pd-h" style={p.overview.length ? 'margin-top:18px;' : undefined} id={p.specs.length || p.overview.length ? undefined : 'h-specs'}>Applications</h2>
						<ul class="pd-apps">{p.applications.map((a) => <li><Icon name={a.icon} class="ic" />{a.text}</li>)}</ul>
						{p.guides.length + reads.length > 0 && <nav class="pd-guides" aria-label="Guides and articles">
							{p.guides.map((g) => <a href={`/guides/${g}`}><Icon name="fa-arrow-right" class="ic" />{guideTitles[g]}</a>)}
							{reads.map((x) => <a href={x.url}><Icon name="fa-arrow-right" class="ic" />{x.title}</a>)}
						</nav>}
					</div>
				</div>
			</div>
		</section>

		{faq.length > 0 && <section class="pd-sec alt" aria-labelledby="h-faq">
			<div class="container">
				<h2 class="pd-h" id="h-faq">{p.name}: frequently asked questions</h2>
				<Faq faq={faq} />
			</div>
		</section>}

		<Quote title={`Get a price for ${p.name}`} service={`Quote: ${p.name}`} pitch={fam.pitch} step1={fam.step1} field={fam.field} ask={fam.ask} />

		{p.related.length > 0 && <section class="pd-sec alt" aria-labelledby="h-related">
			<div class="container">
				<h2 class="pd-h" id="h-related">More in {p.family.name}</h2>
				<div class="pd-related">
					{p.related.map((r) => (
						<a href={`/${r}`}>{products[r].image && <img src={products[r].image} alt="" loading="lazy" width="160" height="130" />}<strong>{products[r].name}</strong>{products[r].capacity && <span>{products[r].capacity}</span>}</a>
					))}
				</div>
			</div>
		</section>}

		<div class="pd-bar">
			<a class="pd-btn pd-btn-line" href="tel:+918028371974"><Icon name="fa-phone" class="ic" />Call</a>
			<a class="pd-btn pd-btn-main" href="#quote">Get a price</a>
		</div>
	</div>
</Base>
