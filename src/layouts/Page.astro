---
// Long pages (blog posts, guides, 404, get-a-quote): Base with a breadcrumb, the article in `prose-ec`, an optional
// quote call-out and the sidebar (quick enquiry, featured products, address). `ld` replaces the generated schema
// (breadcrumb plus `schema`) when a page brings its own complete set, as the converted pages in src/content/pages do.
import Base from './Base.astro';
import Breadcrumb from '../components/site/Breadcrumb.astro';
import Sidebar from '../components/site/Sidebar.astro';
import Icon from '../components/site/Icon.astro';
import { urlFor } from '../lib/site.js';
import { SALES_PHONE } from '../data/nav.js';

const { slug, title, description, h1, crumbs = [], schema = [], ld: own, sidebar = true, cta = true, noindex = false, image = '/image/logo2.png', type, published } = Astro.props;

const trail = [{ name: 'Home', url: '/' }, ...crumbs];
const ld = own ?? [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [...trail, { name: h1, url: `/${slug}` }].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: `${urlFor('index').slice(0, -1)}${c.url}`,
    })),
  },
  ...schema,
];
---
<Base slug={slug} title={title} description={description} image={image} type={type} published={published} schema={ld} noindex={noindex} enquiry>
  <Breadcrumb trail={trail} current={h1} />
  <div class={`container grid gap-10 py-10 lg:py-14 ${sidebar ? 'lg:grid-cols-[minmax(0,1fr)_22rem]' : ''}`}>
    <article class="min-w-0">
      <h1 class="border-b-2 border-brand-600 pb-3 font-display text-[1.75rem] font-semibold leading-tight text-navy-900 sm:text-[2rem]">{h1}</h1>
      <div class="prose-ec mt-6"><slot /></div>
      {cta && (
        <section class="mt-10 rounded-2xl bg-navy-900 p-7 text-white" aria-labelledby="cta-h">
          <h2 id="cta-h" class="font-display text-xl font-semibold text-white">Ready to power your critical infrastructure?</h2>
          <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-slate-300">Consult E&amp;C Power Systems engineers for a load audit, product sizing and a quotation built to your technical specification.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/get-a-quote" class="btn-solid h-11 px-5 text-sm">Request a quote</a>
            <a href={`tel:${SALES_PHONE.tel}`} class="btn-ghost h-11 px-5 text-sm"><Icon name="phone" class="size-4" />{SALES_PHONE.label}</a>
          </div>
        </section>
      )}
    </article>
    {sidebar && <Sidebar />}
  </div>
</Base>
