---
// Blog index, page 1 (replaces the legacy /blogs page; keeps its #videos anchor). Later pages: blogs/page/[page].astro.
import BlogList from '../components/BlogList.astro';
import { posts, paged } from '../lib/blog.js';

const pages = paged(posts);
---
<BlogList items={pages[0]} page={1} pages={pages.length} base="/blogs" />
