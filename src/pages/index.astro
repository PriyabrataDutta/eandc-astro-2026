---
// Homepage (Astro + Tailwind). Title and description from src/data/seo.js, schema from src/data/schema-home.js; the
// H1 keeps the ranking keyword. No client JavaScript except the shared enquiry form script.
import Base from '../layouts/Base.astro';
import Icon from '../components/site/Icon.astro';
import { meta } from '../data/seo.js';
import { homeSchema } from '../data/schema-home.js';
import { posts, longDate, postUrl } from '../lib/blog.js';
import { states } from '../data/locations.js';
import { customers } from '../data/customers.js';
import { PHONE, EMAIL } from '../data/nav.js';


const img = (p) => `/image/${p.split('/').map(encodeURIComponent).join('/')}`;

const stats = [
  ['award', '40+', 'Years of engineering'],
  ['layers', '1 Lakh+', 'Installations across India'],
  ['pin', '8', 'Offices across India'],
  ['headset', 'All-India', 'Sales and service'],
];

const lead = [
  ['zap', 'Online UPS', '1 kVA to 1200 kVA double-conversion UPS for offices, hospitals, banks and data centres.', '/online-ups', 'home/online ups.jpg'],
  ['factory', 'Industrial UPS', 'Rugged IP41 / IP55, MIL grade and marine UPS for plants, defence and harsh sites.', '/industrial-ups-manufacturer-in-india', 'product/ip-41.jpg'],
  ['sun', 'Solar solutions', 'Grid-tie, hybrid and off-grid inverters, MPPT controllers and solar DC UPS.', '/solar-solutions', 'home/solar soltuion.jpg'],
  ['plug', 'EV chargers', 'AC 3 to 22 kW and DC 10 to 240 kW chargers for fleets and commercial parking.', '/ev-charger-manufacturer-in-india', 'home/EV Charger.jpg'],
];

const range = [
  ['Modular UPS', '10 to 1200 kVA', '/renatamodular', 'product/Renata modular ups online.jpg'],
  ['Line interactive UPS', '600 VA to 5 kVA', '/lineups', 'product/Line Interactive.jpg'],
  ['Industrial inverters', '3 to 100 kVA', '/power-inverter-manufacturer-in-india', 'home/industrial Inverters.jpg'],
  ['Home inverters', '600 VA to 5 kVA', '/domestic-Inverters', 'Domestic Inverter.jpg'],
  ['Voltage stabilizers', '2 to 1000 kVA', '/stabilizer', 'home/Aries_Air_Cooled.jpg'],
  ['UPS batteries', 'SMF, tubular, Ni-Cd, lithium', '/ups-batteries', 'home/amaron quanta.jpg'],
  ['Battery chargers', '48 / 110 / 220 V DC', '/industrial-battery-charger-fcbc', 'product/ups battery charger.jpg'],
  ['UPS accessories', 'Isolation, STS, SNMP', '/ups-accessories', 'product/isolation_transformer.jpg'],
  ['Remote monitoring', 'UPS, battery, DG', '/remote-monitoring-system', 'home/Remote Monitoring.jpg'],
  ['Custom solutions', 'Designed to your spec', '/custom-solutions', 'home/Custom Solutions.jpg'],
];

const sectors = [
  ['server', 'Data centres', 'Information_Technology.jpg', postUrl('how-to-size-ups-for-data-centre')],
  ['heart', 'Healthcare', 'Hospitality-Industry.jpg', postUrl('ups-for-hospitals-and-fire-alarm-systems')],
  ['factory', 'Manufacturing', 'Manufactures.jpg', '/industrial-ups-manufacturer-in-india'],
  ['bank', 'Banking', 'banking2.jpg', postUrl('ups-for-banks-and-atms')],
  ['shield', 'Defence', 'Defence-Defence-Industry.jpg', postUrl('rugged-ups-for-defence-vehicles-and-radar')],
  ['layers', 'Commercial buildings', 'real_estate.jpg', postUrl('power-backup-for-commercial-buildings')],
];

const why = [
  ['shieldcheck', 'Proven reliability', 'Over one lakh installations across India, at banks, hospitals, factories and defence sites.'],
  ['flask', 'Engineering in-house', 'Design, R&D and manufacturing at our Peenya plant, including custom builds.', '/research-and-development'],
  ['users', 'Service network', 'Regional offices from Kochi to Jammu, with engineers for installation and breakdowns.', '/contact#sales-offices'],
  ['refresh', 'Lifecycle support', 'Sizing, commissioning, AMC, battery replacement and upgrades for the life of the system.', '/eandcpower-services'],
];

const services = [
  ['wrench', 'AMC and maintenance', 'Preventive visits and breakdown support under an annual contract.'],
  ['cog', 'Installation', 'Site survey, cabling and safe installation by our engineers.'],
  ['clipboard', 'Commissioning', 'Load testing, battery checks and handover with records.'],
  ['battery', 'Battery replacement', 'Health checks and planned replacement before batteries fail.'],
];

const testimonials = [
  ['We placed quite a few orders with E&C and they supplied and installed within the scheduled time. The service personnel are technical and customer friendly, preventive maintenance is on schedule, and we are happy with the performance and service.', 'Vinay Saxena', 'Asst. Vice President, Zee Entertainment Enterprises'],
  ['We at Union Bank of India have bought a number of machines from E&C for our branches at Rewa, starting from 1 kVA. After-sales support is very good and preventive maintenance of all our UPS is done regularly. We are very satisfied.', 'Union Bank of India', 'Rewa Branch'],
];

const latest = posts.slice(0, 3);
const field = 'w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-[15px] text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none';
---
<Base slug="index" title={meta.index.title} description={meta.index.description} image="/image/home/online%20ups.jpg" schema={[homeSchema]} enquiry>
    <!-- Hero -->
    <section class="hero-grid relative overflow-hidden bg-navy-900 text-white">
      <div class="wrap grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-24">
        <div>
          <p class="mb-5 inline-flex rounded-full border border-white/15 bg-white/5 px-3 py-1 text-sm text-brand-100">Since 1978, engineered in Peenya, Bengaluru</p>
          <h1 class="text-[2.1rem] leading-[1.12] font-bold tracking-tight text-white sm:text-5xl lg:text-[3.4rem]">
            Online UPS Manufacturer in Bangalore, India
          </h1>
          <p class="mt-5 text-lg font-medium text-white sm:text-xl">Powering what matters. Protecting what’s next.</p>
          <p class="mt-3 max-w-xl leading-relaxed text-slate-300">Dependable UPS and critical power systems for offices, hospitals, banks, factories and defence sites, designed and built in Bengaluru, and backed by over 40 years of engineering, manufacturing and service.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#products" class="btn-solid h-12 px-6">Explore products<Icon name="arrow" class="size-4" /></a>
            <a href="/contact" class="btn-ghost h-12 px-6"><Icon name="chat" class="size-4" />Talk to an expert</a>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <figure class="relative rounded-3xl bg-white p-4 shadow-2xl shadow-black/40 ring-1 ring-white/10">
            <img src={img('product/Renata modular ups online.jpg')} alt="E&C Renata Modular online UPS and rack mount UPS" width="400" height="343" fetchpriority="high" class="h-auto w-full" />
            <figcaption class="absolute bottom-4 left-4 rounded-lg bg-navy-900/90 px-3 py-2 text-xs text-white">Renata Modular, 10 to 1200 kVA</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section aria-label="E&C in numbers" class="bg-navy-950 text-white">
      <ul class="wrap grid grid-cols-2 divide-white/10 py-6 lg:grid-cols-4 lg:divide-x">
        {stats.map(([i, n, l]) => (
          <li class="flex items-center gap-3 px-2 py-3 lg:justify-center">
            <Icon name={i} class="size-8 shrink-0 text-cyan-accent" />
            <p><span class="block font-display text-xl font-bold sm:text-2xl">{n}</span><span class="text-xs text-slate-300 sm:text-sm">{l}</span></p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Lead products -->
    <section id="products" class="scroll-mt-24 bg-slate-50 py-16 sm:py-20">
      <div class="wrap">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <h2 class="sec-h">Online UPS, industrial UPS, solar and EV charging</h2>
          <a href="/sitemap" class="more">View all products<Icon name="arrow" class="size-4" /></a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {lead.map(([i, h, t, u, im]) => (
            <a href={u} class="reveal group grid grid-cols-[7.5rem_1fr] overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-600/10 sm:flex sm:flex-col">
              <div class="flex items-center justify-center bg-white p-2 sm:aspect-[4/3] sm:p-4"><img src={img(im)} alt="" width="320" height="240" loading="lazy" class="h-auto w-full object-contain sm:h-full sm:w-auto" /></div>
              <div class="flex flex-1 flex-col border-l border-slate-100 p-4 sm:border-t sm:border-l-0 sm:p-5">
                <h3 class="flex items-center gap-2 text-lg font-semibold"><Icon name={i} class="size-5 text-brand-600" />{h}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{t}</p>
                <span class="more mt-3 sm:mt-4">Know more<Icon name="arrow" class="size-4" /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Industries -->
    <section class="py-16 sm:py-20" aria-labelledby="h-ind">
      <div class="wrap grid gap-8 lg:grid-cols-[0.8fr_2.2fr] lg:items-center">
        <div>
          <h2 id="h-ind" class="sec-h">Industries we power</h2>
          <p class="mt-3 leading-relaxed text-slate-600">Trusted across critical sectors for uninterrupted, clean and reliable power, from bank branches and hospitals to factories and defence vehicles.</p>
          <a href="/blogs/online-ups" class="more mt-5">All sector guides<Icon name="arrow" class="size-4" /></a>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {sectors.map(([i, h, im, u]) => (
            <a href={u} class="reveal group relative aspect-[4/3] overflow-hidden rounded-xl bg-navy-900">
              <img src={img(im)} alt="" width="300" height="225" loading="lazy" class="absolute inset-0 size-full object-cover opacity-80 transition-opacity duration-500 group-hover:opacity-60" />
              <span class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/30 to-transparent"></span>
              <span class="absolute inset-x-0 bottom-0 flex items-center gap-2 p-3 font-display text-sm font-semibold text-white sm:p-4 sm:text-base"><Icon name={i} class="size-5 shrink-0" />{h}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="bg-slate-50 py-16 sm:py-20" aria-labelledby="h-about">
      <div class="wrap grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <figure class="reveal overflow-hidden rounded-2xl shadow-lg">
          <img src="/image/about.jpg" alt="E&C Power Systems building in Peenya Industrial Area, Bengaluru" width="640" height="427" loading="lazy" class="h-auto w-full" />
        </figure>
        <div>
          <h2 id="h-about" class="sec-h">A legacy of engineering excellence since 1978</h2>
          <p class="mt-4 leading-relaxed text-slate-600">Electronics &amp; Controls Power Systems is one of India's oldest manufacturers of online UPS, with over 40 years in power electronics. Our teams in R&amp;D, manufacturing, sales and service design, build and look after UPS, inverters, stabilizers and power conditioning for offices, hospitals, banks, factories and defence sites across India.</p>
          <ul class="mt-7 grid gap-4 sm:grid-cols-3">
            <li class="flex items-center gap-3 text-sm font-semibold text-navy-900"><span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><Icon name="factory" /></span>Made in Bengaluru</li>
            <li class="flex items-center gap-3 text-sm font-semibold text-navy-900"><span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><Icon name="flask" /></span>In-house R&amp;D</li>
            <li class="flex items-center gap-3 text-sm font-semibold text-navy-900"><span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><Icon name="award" /></span>ISO 9001 &amp; 14001</li>
          </ul>
          <a href="/about-us" class="more mt-7">More about E&amp;C<Icon name="arrow" class="size-4" /></a>
        </div>
      </div>
    </section>

    <!-- Why choose -->
    <section class="py-16 sm:py-20" aria-labelledby="h-why">
      <div class="wrap">
        <h2 id="h-why" class="sec-h">Why choose E&amp;C Power</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {why.map(([i, h, t, u]) => (
            <div class="reveal grid grid-cols-[3rem_1fr] gap-x-4 rounded-2xl border border-slate-200 p-5 sm:block sm:p-6">
              <span class="row-span-2 flex size-12 items-center justify-center rounded-xl bg-brand-600 text-white"><Icon name={i} class="size-6" /></span>
              <h3 class="text-lg font-semibold sm:mt-4">{u ? <a href={u} class="hover:text-brand-600">{h}</a> : h}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 sm:mt-2">{t}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Full range -->
    <section class="bg-slate-50 py-16 sm:py-20" aria-labelledby="h-range">
      <div class="wrap">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div><h2 id="h-range" class="sec-h">The full product range</h2><p class="mt-2 text-slate-600">A complete range of power products for diverse applications.</p></div>
          <a href="/ups-price-in-india" class="more">UPS prices<Icon name="arrow" class="size-4" /></a>
        </div>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5 lg:gap-4">
          {range.map(([h, c, u, im]) => (
            <li class="reveal">
              <a href={u} class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-3 transition hover:border-brand-300 hover:shadow-lg sm:p-4">
                <span class="flex aspect-square items-center justify-center"><img src={img(im)} alt="" width="180" height="180" loading="lazy" class="max-h-full w-auto object-contain" /></span>
                <span class="mt-3 flex items-start justify-between gap-2">
                  <span><span class="block text-sm font-semibold text-navy-900 group-hover:text-brand-600">{h}</span><span class="text-xs text-slate-500">{c}</span></span>
                  <Icon name="arrow" class="mt-0.5 size-4 shrink-0 text-brand-600 transition group-hover:translate-x-0.5" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Services -->
    <section class="py-16 sm:py-20" aria-labelledby="h-svc">
      <div class="wrap overflow-hidden rounded-3xl bg-navy-900 text-white">
        <div class="hero-grid grid gap-10 p-6 sm:p-10 lg:grid-cols-2 lg:p-14">
          <div>
            <h2 id="h-svc" class="sec-h text-white">End-to-end service for uninterrupted power</h2>
            <p class="mt-4 max-w-md leading-relaxed text-slate-300">From sizing and installation to AMC and battery replacement, our engineers keep your power systems running at peak performance across India.</p>
            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
              <a href="/eandcpower-services" class="btn-solid h-12 px-6">Service and AMC<Icon name="arrow" class="size-4" /></a>
              <a href={`tel:${PHONE.tel}`} class="btn-ghost h-12 px-6"><Icon name="phone" class="size-4" />{PHONE.label}</a>
            </div>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2">
            {services.map(([i, h, t]) => (
              <li class="grid grid-cols-[2rem_1fr] gap-x-3 rounded-2xl border border-white/10 bg-white/5 p-4 sm:block sm:p-5">
                <Icon name={i} class="row-span-2 size-7 text-cyan-accent" />
                <h3 class="font-semibold text-white sm:mt-3">{h}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-300">{t}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="bg-slate-50 py-16 sm:py-20" aria-labelledby="h-trust">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-[1fr_2fr]">
          <div>
            <h2 id="h-trust" class="sec-h">Trusted by industry, backed by standards</h2>
            <p class="mt-3 leading-relaxed text-slate-600">Our UPS run at public sector banks, research and defence organisations, railways and leading companies across India.</p>
            <ul class="mt-6 flex flex-wrap gap-3">
              {['ISO 9001', 'ISO 14001'].map((c) => <li class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-navy-900"><Icon name="award" class="size-5 text-brand-600" />{c} certified</li>)}
            </ul>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            {testimonials.map(([q, n, r]) => (
              <figure class="reveal flex flex-col rounded-2xl border border-slate-200 bg-white p-6">
                <Icon name="quote" class="size-7 text-brand-300" />
                <blockquote class="mt-3 flex-1 text-[15px] leading-relaxed text-slate-700">{q}</blockquote>
                <figcaption class="mt-5 border-t border-slate-100 pt-4"><span class="block font-semibold text-navy-900">{n}</span><span class="text-sm text-slate-500">{r}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
        <div class="marquee mt-12 overflow-hidden" aria-label="Some of our customers">
          <ul class="marquee-track flex w-max items-center gap-4">
            {[0, 1].map((copy) => customers.map(([f, n]) => (
              <li class="flex h-20 w-32 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white p-3" aria-hidden={copy ? 'true' : undefined}>
                <img src={`/image/${f}`} alt={copy ? '' : n} width="95" height="65" loading="lazy" class="max-h-full w-auto object-contain" />
              </li>
            )))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Across India -->
    <section class="py-16 sm:py-20" aria-labelledby="h-india">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div><h2 id="h-india" class="sec-h">Sales and service in every region</h2><p class="mt-2 max-w-2xl text-slate-600">Head office and plant in Bengaluru, with regional offices in Chennai, Kochi, Mumbai, Kolkata, New Delhi, Indore and Jammu.</p></div>
          <a href="/ups-manufacturer-in-india" class="more">UPS manufacturer in India<Icon name="arrow" class="size-4" /></a>
        </div>
        <ul class="mt-7 flex flex-wrap gap-2">
          {states.map((s) => <li><a href={`/${s.slug}`} class="inline-flex min-h-10 items-center rounded-full border border-slate-200 px-4 text-sm text-slate-700 hover:border-brand-500 hover:bg-brand-50 hover:text-brand-700">{s.name}</a></li>)}
        </ul>
      </div>
    </section>

    <!-- Blog -->
    <section class="bg-slate-50 py-16 sm:py-20" aria-labelledby="h-blog">
      <div class="wrap">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <h2 id="h-blog" class="sec-h">UPS guides from our engineers</h2>
          <a href="/blogs" class="more">All articles<Icon name="arrow" class="size-4" /></a>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {latest.map((p) => (
            <a href={p.url} class="reveal group overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:shadow-lg">
              <img src={p.cover} alt="" width="400" height="210" loading="lazy" class="aspect-[1200/630] w-full object-cover" />
              <div class="p-5">
                <span class="text-sm font-medium text-brand-600">{p.tag}</span>
                <h3 class="mt-2 font-semibold leading-snug group-hover:text-brand-600">{p.title}</h3>
                <p class="mt-2 text-xs text-slate-500"><time datetime={p.date}>{longDate(p.date)}</time>, {p.minutes} min read</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Enquiry -->
    <section id="enquire" class="hero-grid scroll-mt-24 bg-navy-900 py-16 text-white sm:py-20" aria-labelledby="h-enq">
      <div class="wrap grid items-start gap-10 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <h2 id="h-enq" class="sec-h text-white sm:text-4xl">Request a consultation or get a quote</h2>
          <p class="mt-4 max-w-md leading-relaxed text-slate-300">Sizing and quotation are free. Tell us your requirement and our engineers will help you choose the right power solution.</p>
          <ul class="mt-7 space-y-3 text-sm">
            <li class="flex items-center gap-3"><Icon name="zap" class="size-5 text-cyan-accent" />Expert advice from UPS engineers</li>
            <li class="flex items-center gap-3"><Icon name="clock" class="size-5 text-cyan-accent" />Quotation usually within one working day</li>
            <li class="flex items-center gap-3"><Icon name="shieldcheck" class="size-5 text-cyan-accent" />Solutions sized to your load and backup time</li>
          </ul>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm">
            <a href={`tel:${PHONE.tel}`} class="flex items-center gap-2 font-semibold hover:text-cyan-accent"><Icon name="phone" class="size-4" />{PHONE.label}</a>
            <a href={`mailto:${EMAIL}`} class="flex items-center gap-2 font-semibold hover:text-cyan-accent"><Icon name="mail" class="size-4" />{EMAIL}</a>
          </div>
        </div>
        <form action="/api/contact" method="POST" data-enquiry class="rounded-2xl bg-white p-6 text-slate-700 shadow-2xl sm:p-8">
          <p class="font-display text-xl font-bold text-navy-900">Enquire now</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div><label for="e-name" class="mb-1.5 block text-sm font-medium">Your name <span class="text-red-600" aria-hidden="true">*</span></label><input id="e-name" name="name" required autocomplete="name" class={field} /></div>
            <div><label for="e-company" class="mb-1.5 block text-sm font-medium">Company</label><input id="e-company" name="company" autocomplete="organization" class={field} /></div>
            <div><label for="e-email" class="mb-1.5 block text-sm font-medium">Email <span class="text-red-600" aria-hidden="true">*</span></label><input id="e-email" type="email" name="email" required autocomplete="email" class={field} /></div>
            <div><label for="e-phone" class="mb-1.5 block text-sm font-medium">Phone <span class="text-red-600" aria-hidden="true">*</span></label><input id="e-phone" type="tel" name="phone" required autocomplete="tel" inputmode="tel" class={field} /></div>
            <div class="sm:col-span-2"><label for="e-type" class="mb-1.5 block text-sm font-medium">Requirement</label>
              <select id="e-type" name="service" class={field}>
                {['Online UPS', 'Industrial UPS', 'Inverter', 'Voltage stabilizer', 'Batteries', 'Solar', 'EV charger', 'Service / AMC', 'Other'].map((o) => <option>{o}</option>)}
              </select>
            </div>
            <div class="sm:col-span-2"><label for="e-msg" class="mb-1.5 block text-sm font-medium">Message or project details <span class="text-red-600" aria-hidden="true">*</span></label><textarea id="e-msg" name="message" rows="3" required placeholder="Load, backup time and site city" class={field}></textarea></div>
          </div>
          <button type="submit" class="btn-solid mt-5 h-12 w-full px-6 sm:w-auto">Submit enquiry<Icon name="arrow" class="size-4" /></button>
          <p class="mt-3 text-xs text-slate-500">Your details are used only to reply to this enquiry.</p>
        </form>
      </div>
    </section>
</Base>
