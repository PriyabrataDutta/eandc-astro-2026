---
import Page from '../layouts/Page.astro';

const products = [
  'Online UPS (1 - 30 kVA)', 'Online UPS (above 30 kVA)', 'Modular UPS', 'Rack Mount UPS', 'Lithium UPS',
  'MIL Grade / IP55 Industrial UPS', 'Line Interactive UPS', 'Industrial Inverter', 'Domestic Inverter',
  'Voltage Stabilizer', 'Isolation Transformer', 'Static Transfer Switch', 'Batteries (SMF / Tubular / Lithium / Ni-Cd)',
  'Industrial Battery Charger (FCBC)', 'Solar Inverter / Solar System', 'EV Charger', 'Remote Monitoring', 'Service / AMC', 'Other',
];
const states = [
  'Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chandigarh', 'Chhattisgarh', 'Delhi', 'Goa', 'Gujarat', 'Haryana',
  'Himachal Pradesh', 'Jammu and Kashmir', 'Jharkhand', 'Karnataka', 'Kerala', 'Ladakh', 'Madhya Pradesh', 'Maharashtra',
  'Manipur', 'Meghalaya', 'Mizoram', 'Nagaland', 'Odisha', 'Puducherry', 'Punjab', 'Rajasthan', 'Sikkim', 'Tamil Nadu',
  'Telangana', 'Tripura', 'Uttar Pradesh', 'Uttarakhand', 'West Bengal', 'Andaman and Nicobar', 'Dadra and Nagar Haveli and Daman and Diu', 'Lakshadweep',
];
const field = 'block w-full min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-[15px] text-slate-900 placeholder:text-slate-500 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20';
const label = 'mb-1 block text-[13px] font-semibold text-slate-800';
const box = 'rounded-xl bg-slate-50 p-5 text-sm leading-relaxed text-slate-600';
---
<Page
  slug="get-a-quote"
  title="Get a UPS Quote | Online & Industrial UPS Price | E&C Power"
  description="Request a quote for online, industrial and modular UPS, inverters, stabilizers, batteries and EV chargers from E&C Power Systems, Bengaluru."
  h1="Get a Quote"
  sidebar={false}
  cta={false}
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div>
      <p>Tell us what you need to power and where. Our engineering team will size the right system and send a quotation, usually within one working day. To see what decides the price first, read <a href="/ups-price-in-india">UPS price in India</a>.</p>
      <form action="/api/contact" method="POST" data-enquiry class="mt-6 grid gap-4 sm:grid-cols-2">
        <div><label class={label} for="q-name">Your name *</label><input id="q-name" type="text" name="name" required autocomplete="name" class={field} /></div>
        <div><label class={label} for="q-company">Company</label><input id="q-company" type="text" name="company" autocomplete="organization" class={field} /></div>
        <div><label class={label} for="q-email">Email *</label><input id="q-email" type="email" name="email" required autocomplete="email" class={field} /></div>
        <div><label class={label} for="q-phone">Phone *</label><input id="q-phone" type="tel" name="phone" required autocomplete="tel" inputmode="tel" class={field} /></div>
        <div><label class={label} for="q-city">City *</label><input id="q-city" type="text" name="city" required autocomplete="address-level2" class={field} /></div>
        <div>
          <label class={label} for="q-state">State *</label>
          <select id="q-state" name="state" required class={field}>
            <option value="">Select state</option>
            {states.map((s) => <option>{s}</option>)}
          </select>
        </div>
        <div>
          <label class={label} for="q-product">Product *</label>
          <select id="q-product" name="service" required class={field}>
            <option value="">Select product</option>
            {products.map((p) => <option>{p}</option>)}
          </select>
        </div>
        <div><label class={label} for="q-kva">Capacity (kVA) / quantity</label><input id="q-kva" type="text" name="capacity" placeholder="e.g. 20 kVA, 2 units" class={field} /></div>
        <div class="sm:col-span-2"><label class={label} for="q-message">Application and requirement *</label><textarea id="q-message" name="message" rows="4" required placeholder="What will the UPS power? Backup time needed? Single or three phase?" class={`${field} py-2.5`}></textarea></div>
        <div class="sm:col-span-2"><button type="submit" class="btn-solid h-11 px-6 text-sm">Request quote</button></div>
      </form>
    </div>
    <div class="flex flex-col gap-5">
      <section class={box} aria-labelledby="q-next">
        <h2 id="q-next" class="!mt-0 font-display text-lg font-semibold text-navy-900">What happens next</h2>
        <ol class="mt-3">
          <li>An engineer reviews your load and application.</li>
          <li>We call you to confirm capacity and backup time.</li>
          <li>You receive a quotation with delivery and installation terms.</li>
        </ol>
      </section>
      <section class={box} aria-labelledby="q-call">
        <h2 id="q-call" class="!mt-0 font-display text-lg font-semibold text-navy-900">Prefer to call?</h2>
        <p class="mt-3"><strong>Phone:</strong> <a href="tel:+918028371974">080 2837 1974</a> / <a href="tel:+918028397120">2839 7120</a><br /><strong>Email:</strong> <a href="mailto:sales@eandcpower.com">sales@eandcpower.com</a></p>
        <p class="mt-2">29/A, 2nd Phase, Peenya Industrial Area, Bengaluru, Karnataka 560058</p>
      </section>
    </div>
  </div>
</Page>
