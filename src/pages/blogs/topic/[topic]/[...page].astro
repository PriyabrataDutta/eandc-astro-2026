---
// Topic pages (/blogs/topic/{topic}, then /page/N), 10 posts each. Navigation aids, so noindex, follow.
import BlogList from '../../../../components/BlogList.astro';
import { topics, topicSlug, paged } from '../../../../lib/blog.js';

export function getStaticPaths() {
  return topics.flatMap(([tag, list]) => {
    const pages = paged(list);
    return pages.map((items, i) => ({
      params: { topic: topicSlug(tag), page: i ? `page/${i + 1}` : undefined },
      props: { items, page: i + 1, pages: pages.length, topic: tag },
    }));
  });
}
const { items, page, pages, topic } = Astro.props;
---
<BlogList items={items} page={page} pages={pages} base={`/blogs/topic/${topicSlug(topic)}`} topic={topic} />
