---
// HTML sitemap: every indexable page, grouped. Built from the same list as /sitemap.xml (src/lib/pages.js), and any
// page not placed in a named group lands in "Other pages", so a new page can never be missing here.
import Hub from '../layouts/Hub.astro';
// Titles of the Markdown pages (src/content/pages), up to the "|".
const contentTitles = Object.fromEntries(Object.entries(import.meta.glob('../content/pages/*.md', { eager: true })).map(([f, m]) => [f.split('/').pop().replace(/\.md$/, ''), m.frontmatter.title.split('|')[0]]));
import { sitePages } from '../lib/pages.js';
import { products, families, guideTitles } from '../data/products.js';
import { states, cities, indexable, cityLink } from '../data/locations.js';
import { posts, topics } from '../lib/blog.js';

const all = new Set(sitePages());
all.delete('sitemap');
const used = new Set();
const NAMES = {
  index: 'Home', blogs: 'Blog', 'about-us': 'About us', management: 'Management', missionandvision: 'Mission and vision',
  'research-and-development': 'Research & development', 'eandcpower-infrastructure': 'Infrastructure', machinery: 'Machinery & utilities',
  newtestimonal: 'Testimonials', careers: 'Careers', catalog: 'Product catalogs', 'frequently-asked-questions': 'FAQs',
  annualreturn: 'Annual return (MGT-7)', contact: 'Contact us', 'eandcpower-sales': 'Sales offices', 'eandcpower-services': 'Service, AMC & repair',
  feedback: 'Feedback', 'custom-solutions': 'Custom UPS solutions', 'ups-manufacturer-in-bangalore': 'Bengaluru', 'get-a-quote': 'Get a quote', 'ups-price-in-india': 'UPS price in India', 'online-ups': 'Online UPS', stabilizer: 'Voltage stabilizers',
  'industrial-ups-manufacturer-in-india': 'Industrial UPS', 'battery-energy-storage-system': 'Battery energy storage (BESS)',
  'marine-ups': 'Marine UPS', 'ups-batteries': 'UPS batteries', 'ups-accessories': 'UPS accessories', 'remote-monitoring-system': 'Remote monitoring', 'ups-manufacturer-in-india': 'UPS manufacturer in India', 'solar-solutions': 'Solar solutions',
  ...Object.fromEntries(states.map((x) => [x.slug, `UPS supplier in ${x.name}`])),
  ...Object.fromEntries(cities.map((x) => [x.slug, x.name])),
};
// Legacy pages: their own title up to the first "|".
const name = (s) => NAMES[s] ?? products[s]?.name ?? guideTitles[s.replace('guides/', '')] ?? (contentTitles[s] ?? s).trim();
const take = (list) => list.filter((s) => all.has(s) && !used.has(s)).map((s) => (used.add(s), { url: s === 'index' ? '/' : `/${s}`, name: name(s) }));

const company = take(['index', 'about-us', 'management', 'missionandvision', 'research-and-development', 'eandcpower-infrastructure', 'machinery', 'newtestimonal', 'careers', 'catalog', 'frequently-asked-questions', 'annualreturn']);
const contact = take(['contact', 'get-a-quote', 'ups-price-in-india', 'eandcpower-sales', 'eandcpower-services', 'feedback']);
const categories = take(['online-ups', 'industrial-ups-manufacturer-in-india', 'stabilizer', 'ups-batteries', 'ups-accessories', 'remote-monitoring-system', 'solar-solutions', 'battery-energy-storage-system', 'marine-ups', 'custom-solutions']);
const productGroups = Object.entries(families)
  .map(([k, f]) => ({ title: f.name, links: take(Object.keys(products).filter((p) => products[p].family === k)) }))
  .filter((g) => g.links.length);

const liveStates = states.filter(indexable);
const stateGroups = liveStates.map((s) => ({
  state: take([s.slug])[0],
  cities: take(s.cities.map((k) => cityLink(k).url.slice(1))).map((c) => ({ ...c, name: c.name.replace(/^UPS Manufacturer in /i, '') })),
}));
const otherCities = take(cities.filter((c) => indexable(c) && !c.parent).map((c) => c.slug)).map((c) => ({ ...c, name: c.name.replace(/^UPS Manufacturer in /i, '') }));
const india = take([...all].filter((s) => s.endsWith('-in-india') || s === 'ups-supplier-in-india'));
const blr = take([...all].filter((s) => s.endsWith('-in-bangalore')));
const guides = take([...all].filter((s) => s.startsWith('guides/')));
const blog = take(['blogs']);
const other = take([...all]);

const groups = [
  { title: 'Company', links: company },
  { title: 'Sales, service and contact', links: contact },
  { title: 'Solutions', links: categories },
];
// Groups longer than this may continue in the next column, so columns end level instead of leaving gaps.
const LONG = 8;
const total = all.size + posts.length;
---
<Hub
  slug="sitemap"
  title="Sitemap | E&C Power Systems"
  description="All pages on the E&C Power Systems website: online UPS, industrial UPS, inverters, stabilizers, batteries, solar, EV chargers, services and locations."
  name="Sitemap"
  quote={false}
>
  <section class="hb-hero sm-hero">
    <div class="container">
      <h1>Sitemap <span>{total} pages</span></h1>
      <nav class="sm-jump" aria-label="Sitemap sections">
        <a href="#company">Company</a><a href="#products">Products</a><a href="#india">UPS across India</a><a href="#bengaluru">Bengaluru</a><a href="#learn">Blog &amp; guides</a>
      </nav>
    </div>
  </section>

  <div class="container sm-wrap">
    <section class="sm-sec" id="company" aria-labelledby="h-company">
      <h2 id="h-company">Company, sales and solutions</h2>
      <div class="sm-cols top">
        {groups.map((g, i) => (
          <div class={`sm-g${i === 0 ? ' split' : ''}`}>
            <h3>{g.title}</h3>
            <ul>{g.links.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="sm-sec" id="products" aria-labelledby="h-products">
      <h2 id="h-products">Products</h2>
      <div class="sm-cols">
        {productGroups.map((g) => (
          <div class={`sm-g${g.links.length > LONG ? ' long' : ''}`}>
            <h3>{g.title}</h3>
            <ul>{g.links.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="sm-sec" id="india" aria-labelledby="h-india">
      <h2 id="h-india">UPS across India</h2>
      <div class="sm-cols wide">
        <div class="sm-g long">
          <h3>India</h3>
          <ul>{india.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul>
        </div>
        <div class="sm-g long">
          <h3>States and cities</h3>
          <ul class="sm-states">
            {stateGroups.map((g) => (
              <li>
                <a class="sm-state" href={g.state.url}>{g.state.name.replace(/^UPS supplier in /i, '')}</a>
                <span class="sm-chips">{g.cities.map((c) => <a href={c.url}>{c.name}</a>)}</span>
              </li>
            ))}
            {otherCities.length > 0 && (
              <li><span class="sm-state">More cities</span><span class="sm-chips">{otherCities.map((c) => <a href={c.url}>{c.name}</a>)}</span></li>
            )}
          </ul>
        </div>
      </div>
    </section>

    <section class="sm-sec" id="bengaluru" aria-labelledby="h-blr">
      <h2 id="h-blr">UPS in Bengaluru</h2>
      <div class="sm-cols wide">
        <div class="sm-g long"><ul>{blr.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul></div>
      </div>
    </section>

    <section class="sm-sec" id="learn" aria-labelledby="h-learn">
      <h2 id="h-learn"><a href="/blogs">{blog[0]?.name ?? 'Blog'}</a> and buying guides</h2>
      <div class="sm-cols wide">
        {topics.map(([tag, slug, list]) => (
          <div class={`sm-g${list.length > LONG ? ' long' : ''}`}>
            <h3><a href={`/blogs/${slug}`}>{tag}</a></h3>
            <ul>{list.map((p) => <li><a href={p.url}>{p.title}</a></li>)}</ul>
          </div>
        ))}
        <div class="sm-g">
          <h3>Buying guides</h3>
          <ul>{guides.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul>
        </div>
        {other.length > 0 && (
          <div class="sm-g">
            <h3>Other pages</h3>
            <ul>{other.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul>
          </div>
        )}
      </div>
    </section>
  </div>
</Hub>

<style is:global>
	/* Directory layout: one panel per section; groups flow through balanced columns. Long groups may continue in
	   the next column (their items never split), so columns end level and there are no gaps. */
	.sm-hero { padding:14px 0 16px; }
	.sm-hero h1 { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin:0 0 10px; }
	.sm-hero h1 span { font-size:12px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:#ffcc80; background:rgba(255,255,255,.12); padding:3px 9px; border-radius:4px; }
	.sm-jump { display:flex; flex-wrap:wrap; gap:6px; }
	.sm-jump a { display:inline-flex; align-items:center; min-height:32px; padding:4px 12px; border-radius:16px; border:1px solid rgba(255,255,255,.3); color:#fff !important; font-size:13px; }
	.sm-jump a:hover { background:rgba(255,255,255,.12); border-color:#ff9900; }
	.sm-wrap { padding-top:18px; padding-bottom:24px; }
	.sm-sec { scroll-margin-top:12px; margin:0 0 16px; }
	.sm-sec h2 { font-size:18px; font-weight:600; color:var(--navy); margin:0 0 8px; }
	.sm-sec h2 a { color:inherit; }
	.sm-cols { background:#fff; border:1px solid var(--line); border-radius:8px; padding:14px 18px 4px; columns:2; column-gap:28px; }
	.sm-cols.wide { columns:1; }
	/* Top: three short groups, each kept whole; Company's 12 links run in two columns. */
	.sm-cols.top { display:grid; grid-template-columns:1fr; gap:0 28px; columns:auto; }
	.sm-g.split ul { columns:2; column-gap:20px; }
	.sm-g { margin:0 0 12px; break-inside:avoid; }
	.sm-g.long { break-inside:auto; }
	.sm-g h3 { font-size:14px; font-weight:600; color:var(--navy); margin:0 0 3px; break-after:avoid; }
	.sm-g h3 a { color:var(--navy); }
	.sm-g ul { list-style:none; margin:0; padding:0; }
	.sm-g li { margin:0; break-inside:avoid; }
	.sm-g li a { display:block; padding:3px 0; font-size:13.5px; line-height:1.35; color:var(--blue); }
	.sm-g li a:hover { color:var(--navy); text-decoration:underline; }
	.sm-states li { display:flex; flex-wrap:wrap; align-items:baseline; gap:2px 8px; padding:4px 0; border-top:1px solid #eef2f6; }
	.sm-states li:first-child { border-top:0; }
	.sm-g .sm-states a.sm-state, .sm-states span.sm-state { display:inline; padding:0; font-size:13.5px; font-weight:600; color:var(--navy); }
	.sm-chips { display:inline-flex; flex-wrap:wrap; gap:4px; }
	.sm-g .sm-chips a { display:inline-block; padding:1px 8px; border-radius:10px; background:var(--tint); font-size:12.5px; }
	.sm-g .sm-chips a:hover { background:var(--blue); color:#fff; text-decoration:none; }
	@media (min-width: 600px) { .sm-cols.wide { columns:2; } .sm-cols.top { grid-template-columns:2fr 1fr 1fr; } }
	@media (min-width: 992px) { .sm-cols { columns:3; } .sm-cols.wide { columns:3; } }
	@media (min-width: 1200px) { .sm-cols { columns:4; } }
</style>
