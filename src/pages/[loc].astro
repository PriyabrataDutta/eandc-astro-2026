---
// State hubs (/ups-supplier-in-{state}) and city pages (/ups-manufacturer-in-{city}) from src/data/locations.js.
// Built for every location; noindex until the location has real local facts (see locations.js).
import Hub from '../layouts/Hub.astro';
import IndiaMap from '../components/IndiaMap.astro';
import Range from '../components/Range.astro';
import Faq from '../components/Faq.astro';
import Quote from '../components/Quote.astro';
import { states, cities, indexable, cityLink, stateOf, SECTORS, kmFromPlant } from '../data/locations.js';
import { ORG_REF, urlFor } from '../lib/legacy.js';
import { officesHtml } from '../data/offices.js';

export function getStaticPaths() {
  return [...states, ...cities].map((p) => ({ params: { loc: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const isCity = p.type === 'city';
const parent = isCity && p.parent ? stateOf(p.parent) : null;
const h1 = isCity ? `UPS Manufacturer in ${p.name}` : `UPS Supplier in ${p.name}`;
const crumbs = [{ name: 'UPS Manufacturer in India', url: '/ups-manufacturer-in-india' }];
if (parent) crumbs.push({ name: `UPS Supplier in ${parent.name}`, url: `/${parent.slug}` });

// Sectors: a city's own; a state's = union of its cities' sectors (Bengaluru counts as IT + auto).
const sectorKeys = isCity
  ? p.sectors
  : [...new Set(p.cities.flatMap((k) => (k === 'bangalore' ? ['it', 'auto'] : cities.find((c) => c.key === k)?.sectors ?? [])))].slice(0, 4);
const sectors = sectorKeys.map((k) => SECTORS[k]);
const topSector = sectors[0];

const intro = isCity
  ? `${p.name}'s industry runs on reliable power, from ${p.areas[0]} to ${p.areas.at(-1)}. E&C Power Systems manufactures online and industrial UPS in Peenya, Bengaluru, and supplies ${p.name} businesses through its all-India sales and service network.`
  : `${p.overview} E&C Power Systems manufactures online and industrial UPS in Peenya, Bengaluru, and supplies businesses across ${p.name} through its all-India sales and service network.`;

const faq = [
  {
    q: `Does E&C supply UPS systems in ${p.name}?`,
    a: `Yes. E&C Power Systems manufactures UPS in Peenya, Bengaluru, and supplies customers across India through its all-India sales and service network.${
      isCity && p.office ? ` Sales for ${p.name} are handled by the E&C ${p.office.city} office (${p.office.address})${p.service ? `, and ${p.name} is on E&C's list of service locations` : ''}.` : ''
    }${!isCity && p.offices.length ? ` Sales across ${p.name} are handled by the E&C ${p.offices.map((o) => o.city).join(' and ')} office.` : ''} Share your site location in the quote form for delivery and installation details in ${p.name}.`,
  },
  {
    q: `Which UPS suits ${topSector.label.toLowerCase()} in ${p.name}?`,
    a: `${topSector.need} E&C's options include ${topSector.links.map((l) => l[0]).join(', ')}. The right model depends on the connected load, backup time and site conditions.`,
  },
  {
    q: `How do I get a UPS price for a site in ${p.name}?`,
    a: 'Send the connected load in kW or kVA, the backup time you need and the site address through the quote form. An E&C engineer sizes the system and sends a quotation.',
  },
  ...(p.faq ?? []),
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    description: `Online and industrial UPS supply, installation and service in ${p.name}, from E&C Power Systems, Bengaluru.`,
    url: urlFor(p.slug),
    serviceType: 'Online UPS and industrial UPS supply, installation and service',
    provider: ORG_REF,
    areaServed: { '@type': isCity ? 'City' : 'State', name: p.name },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
// Map: a city shows itself and its neighbours; a state shows its cities.
const mapOn = isCity ? [p.key] : p.cities.filter((k) => k !== 'bangalore');
const mapLabels = isCity ? [p.key, ...p.nearby.filter((k) => k !== 'bangalore')] : mapOn;
const km = isCity ? kmFromPlant(p.key) : null;
const stateCities = isCity ? [] : p.cities.map((k) => ({ ...cityLink(k), c: cities.find((x) => x.key === k), km: k === 'bangalore' ? 0 : kmFromPlant(k) }));
const others = isCity ? [] : states.filter((x) => x.key !== p.key);
const offices = isCity
  ? p.office && officesHtml({ only: [p.office.key], here: p.office.key, heading: p.office.key === p.key ? `Our sales office in ${p.name}` : 'Your nearest E&amp;C sales office', intro: p.office.key === p.key ? `Visit or write to the E&amp;C regional office in ${p.name}.` : `Sales and service for ${p.name} are handled by the E&amp;C ${p.office.city} office.` })
  : p.offices.length && officesHtml({ only: p.offices.map((o) => o.key), heading: `E&amp;C sales offices for ${p.name}`, intro: `Sales and service across ${p.name} are handled by these E&amp;C offices.` });
const range = ['accenta', 'renata', 'renatacyclone', 'renata300', 'renatamodular', 'rack-mount', 'ip-41-55-online-ups', 'industrial-inverter', 'isolation', 'air_oil'];
---
<Hub
  slug={p.slug}
  title={`${h1} | E&C Power`}
  description={`${h1}: online and industrial UPS, inverters and stabilizers for ${p.name}'s industries, from E&C Power Systems, a UPS manufacturer since 1978.`}
  name={h1}
  crumbs={crumbs}
  schema={schema}
  noindex={!indexable(p)}
>
  <section class="hb-hero">
    <div class="container">
      <div class="pd-wrap">
        <div>
          <span class="pd-eyebrow">{isCity ? `${parent ? parent.name : 'India'} · about ${km} km from our plant` : `${p.cities.length} cities in ${p.name}`}</span>
          <h1>{h1}</h1>
          <p class="hb-lead">{intro}</p>
          <ul class="pd-chips">
            {sectors.slice(0, 3).map((s) => <li><em class={`fa ${s.icon}`} aria-hidden="true"></em>{s.label}</li>)}
          </ul>
          <div class="pd-ctas">
            <a class="pd-btn pd-btn-main" href="#quote">Get a price</a>
            <a class="pd-btn pd-btn-line" href="tel:+918028371974"><em class="fa fa-phone" aria-hidden="true"></em>080 2837 1974</a>
          </div>
        </div>
        <IndiaMap highlight={mapOn} labels={mapLabels} title={isCity ? `${p.name} and nearby cities, supplied from Bengaluru` : `Cities in ${p.name} supplied from Bengaluru`} />
      </div>
    </div>
  </section>

  <div class="container">
    <ul class="pd-trust">
      <li><em class="fa fa-check" aria-hidden="true"></em>UPS manufacturer since 1978</li>
      <li><em class="fa fa-industry" aria-hidden="true"></em>Designed and built in Peenya, Bengaluru</li>
      <li><em class="fa fa-truck" aria-hidden="true"></em>Supply, installation and AMC in {p.name}</li>
    </ul>
  </div>

  {isCity ? (
    <section class="pd-sec" aria-labelledby="h-areas">
      <div class="container">
        <h2 class="pd-h" id="h-areas">Power backup for {p.name}'s industrial areas</h2>
        <p class="hb-sub">Major industrial and business areas in {p.name}:</p>
        <ul class="hb-tags">{p.areas.map((a) => <li><span><em class="fa fa-map-marker" aria-hidden="true"></em> {a}</span></li>)}</ul>
      </div>
    </section>
  ) : (
    <section class="pd-sec" aria-labelledby="h-cities">
      <div class="container">
        <h2 class="pd-h" id="h-cities">Cities we serve in {p.name}</h2>
        <div class="hb-cards three">
          {stateCities.map((c) => (
            <a class="hb-card" href={c.url}>
              <h3>UPS manufacturer in {c.name}</h3>
              <p>{c.km ? `About ${c.km} km from our Bengaluru plant` : 'Home of our plant in Peenya'}</p>
              <ul class="hb-tags">{(c.c ? c.c.areas.slice(0, 3) : ['Peenya', 'Electronic City', 'Whitefield']).map((a) => <li><span>{a}</span></li>)}</ul>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="pd-sec alt" aria-labelledby="h-ind">
    <div class="container">
      <h2 class="pd-h" id="h-ind">UPS for {p.name}'s key industries</h2>
      <div class="hb-cards">
        {sectors.map((s) => (
          <div class="hb-card hb-ind">
            <span class="hb-ic"><em class={`fa ${s.icon}`} aria-hidden="true"></em></span>
            <h3>{s.label}</h3>
            <p>{s.need}</p>
            <p class="hb-rec">{s.links.map((l, i) => (<>{i > 0 && ' · '}<a href={l[1]}>{l[0]}</a></>))}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pd-sec" aria-labelledby="h-range">
    <div class="container">
      <h2 class="pd-h" id="h-range">UPS and power backup range</h2>
      <Range slugs={range} />
      <p class="hb-p" style="margin-top:14px;">Also: <a href="/mil-grade">MIL grade UPS</a>, <a href="/smf">UPS batteries</a>, <a href="/industrial-battery-charger-fcbc">battery chargers</a>, <a href="/solar-solutions">solar systems</a> and <a href="/ev-chargers">EV chargers</a>. Not sure what size you need? Read <a href="/guides/ups-sizing-kva">how to size a UPS</a>.</p>
    </div>
  </section>

  <section class="pd-sec alt" aria-labelledby="h-svc">
    <div class="container">
      <h2 class="pd-h" id="h-svc">Supply, installation and service in {p.name}</h2>
      <ul class="hb-why">
        <li><em class="fa fa-industry" aria-hidden="true"></em><span><strong>Built in Bengaluru</strong>Design, R&amp;D and manufacturing in Peenya Industrial Area, since 1978.</span></li>
        <li><em class="fa fa-truck" aria-hidden="true"></em><span><strong>Delivered to your site</strong>All-India sales and service network, with over 1 lakh installations across India.</span></li>
        <li><em class="fa fa-cogs" aria-hidden="true"></em><span><strong>Installed and commissioned</strong>By trained engineers, with load and battery checks at handover.</span></li>
        <li><em class="fa fa-wrench" aria-hidden="true"></em><span><strong>Looked after</strong>AMC, battery replacement and breakdown service: see <a href="/eandcpower-services">UPS service and AMC</a>.</span></li>
        {p.facts.map((f) => <li><em class="fa fa-check" aria-hidden="true"></em><span>{f}</span></li>)}
      </ul>
      {p.service && <p class="hb-p" style="margin-top:12px;">{p.service}</p>}
    </div>
  </section>

  {offices && <Fragment set:html={offices} />}

  <section class="pd-sec" aria-labelledby="h-faq">
    <div class="container">
      <h2 class="pd-h" id="h-faq">Frequently asked questions</h2>
      <Faq faq={faq} />
    </div>
  </section>

  <section class="pd-sec alt" aria-labelledby="h-more">
    <div class="container">
      <h2 class="pd-h" id="h-more">{isCity ? 'Nearby locations' : 'More states'}</h2>
      <ul class="hb-tags">
        {isCity && p.nearby.map(cityLink).map((c) => <li><a href={c.url}>UPS manufacturer in {c.name}</a></li>)}
        {parent && <li><a href={`/${parent.slug}`}>UPS supplier in {parent.name}</a></li>}
        {others.map((x) => <li><a href={`/${x.slug}`}>UPS supplier in {x.name}</a></li>)}
        <li><a href="/ups-manufacturer-in-india">UPS manufacturer in India</a></li>
      </ul>
    </div>
  </section>

  <Quote title={`Get a UPS quotation for ${p.name}`} service={`Quote: UPS (${p.name})`} step1={`Share your load, backup time and site in ${p.name}`} />
</Hub>
