---
import Icon from '../components/site/Icon.astro';
// State hubs (/ups-supplier-in-{state}) and city pages (/ups-manufacturer-in-{city}) from src/data/locations.js.
// Built for every location; noindex until the location has real local facts (see locations.js).
import Hub from '../layouts/Hub.astro';
import IndiaMap from '../components/IndiaMap.astro';
import Range from '../components/Range.astro';
import Faq from '../components/Faq.astro';
import Quote from '../components/Quote.astro';
import { states, cities, indexable, cityLink, stateOf, SECTORS, kmFromPlant } from '../data/locations.js';
import { ORG_REF, urlFor } from '../lib/site.js';
import Offices from '../components/site/Offices.astro';
import { products } from '../data/products.js';
import LOCAL from '../data/local.json';

export function getStaticPaths() {
  return [...states, ...cities].map((p) => ({ params: { loc: p.slug }, props: { p } }));
}

const { p } = Astro.props;
// Local operating conditions, needs and FAQs written for this place (src/data/local.json), so pages differ in substance.
const local = LOCAL[p.key] ?? { needs: [], faq: [] };
const isCity = p.type === 'city';
const parent = isCity && p.parent ? stateOf(p.parent) : null;
const h1 = isCity ? `UPS Manufacturer in ${p.name}` : `UPS Supplier in ${p.name}`;
const crumbs = [{ name: 'UPS Manufacturer in India', url: '/ups-manufacturer-in-india' }];
if (parent) crumbs.push({ name: `UPS Supplier in ${parent.name}`, url: `/${parent.slug}` });

// Sectors: a city's own; a state's = union of its cities' sectors (Bengaluru counts as IT + auto).
const sectorKeys = isCity
  ? p.sectors
  : [...new Set(p.cities.flatMap((k) => (k === 'bangalore' ? ['it', 'auto'] : cities.find((c) => c.key === k)?.sectors ?? [])))].slice(0, 4);
const sectors = sectorKeys.map((k) => SECTORS[k]);
const topSector = sectors[0];

const intro = isCity
  ? `${p.name}'s industry runs on reliable power, from ${p.areas[0]} to ${p.areas.at(-1)}. E&C Power Systems manufactures online and industrial UPS in Peenya, Bengaluru, and supplies ${p.name} businesses through its all-India sales and service network.`
  : `${p.overview} E&C Power Systems manufactures online and industrial UPS in Peenya, Bengaluru, and supplies businesses across ${p.name} through its all-India sales and service network.`;

const faq = [
  {
    q: `Does E&C supply UPS systems in ${p.name}?`,
    a: `Yes. E&C Power Systems manufactures UPS in Peenya, Bengaluru, and supplies customers across India through its all-India sales and service network.${
      isCity && p.office ? ` Sales for ${p.name} are handled by the E&C ${p.office.city} office (${p.office.address})${p.service ? `, and ${p.name} is on E&C's list of service locations` : ''}.` : ''
    }${!isCity && p.offices.length ? ` Sales across ${p.name} are handled by the E&C ${p.offices.map((o) => o.city).join(' and ')} office.` : ''} Share your site location in the quote form for delivery and installation details in ${p.name}.`,
  },
  {
    q: `Which UPS suits ${topSector.label.toLowerCase()} in ${p.name}?`,
    a: `${topSector.need} E&C's options include ${topSector.links.map((l) => l[0]).join(', ')}. The right model depends on the connected load, backup time and site conditions.`,
  },
  {
    q: `How do I get a UPS price for a site in ${p.name}?`,
    a: 'Send the connected load in kW or kVA, the backup time you need and the site address through the quote form. An E&C engineer sizes the system and sends a quotation.',
  },
  ...local.faq,
  ...(p.faq ?? []),
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    description: `Online and industrial UPS supply, installation and service in ${p.name}, from E&C Power Systems, Bengaluru.`,
    url: urlFor(p.slug),
    serviceType: 'Online UPS and industrial UPS supply, installation and service',
    provider: ORG_REF,
    areaServed: { '@type': isCity ? 'City' : 'State', name: p.name },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
// Map: a city shows itself and its neighbours; a state shows its cities.
const mapOn = isCity ? [p.key] : p.cities.filter((k) => k !== 'bangalore');
const mapLabels = isCity ? [p.key, ...p.nearby.filter((k) => k !== 'bangalore')] : mapOn;
const km = isCity ? kmFromPlant(p.key) : null;
const stateCities = isCity ? [] : p.cities.map((k) => ({ ...cityLink(k), c: cities.find((x) => x.key === k), km: k === 'bangalore' ? 0 : kmFromPlant(k) }));
const others = isCity ? [] : states.filter((x) => x.key !== p.key);
const offices = isCity
  ? p.office && { only: [p.office.key], here: p.office.key, heading: p.office.key === p.key ? `Our sales office in ${p.name}` : 'Your nearest E&C sales office', intro: p.office.key === p.key ? `Visit or write to the E&C regional office in ${p.name}.` : `Sales and service for ${p.name} are handled by the E&C ${p.office.city} office.` }
  : p.offices.length && { only: p.offices.map((o) => o.key), heading: `E&C sales offices for ${p.name}`, intro: `Sales and service across ${p.name} are handled by these E&C offices.` };
// Range: the products this place's industries call for first, then the core online UPS line.
const range = [...new Set([...sectors.flatMap((s) => s.links.map((l) => l[1].slice(1))), 'renata', 'renata300', 'renatamodular'])].filter((s) => products[s]?.image).slice(0, 8);

// Local-intent keywords ("online UPS in Pune"): one card each, linking to the national page that ranks for the
// keyword itself. Text is built from this place's sectors, areas and office so pages differ; cards whose sectors
// match the place come first.
// Area names can contain "and" themselves, so list them with commas.
const where = isCity ? `around ${p.areas.slice(0, 2).join(', ')}` : `in ${stateCities.filter((c) => c.c).slice(0, 3).map((c) => c.name).join(', ')}`;
// A state matches on all its cities' sectors, not just the four shown in the industries section.
const fitKeys = isCity ? sectorKeys : [...new Set(p.cities.flatMap((k) => cities.find((c) => c.key === k)?.sectors ?? []))];
const lower = (s) => (/^[A-Z][a-z]/.test(s) ? s[0].toLowerCase() + s.slice(1) : s); // keeps "IT"
const labelsFor = (keys, fallback) => fitKeys.filter((k) => keys.includes(k)).map((k) => lower(SECTORS[k].label)).join('; ') || fallback;
const svcOffice = isCity ? p.office : p.offices[0];
const serviceLine = isCity && p.service
  ? `${p.service} `
  : svcOffice ? `Service ${isCity ? 'in' : 'across'} ${p.name} is run from the E&C ${isCity ? svcOffice.city : p.offices.map((o) => o.city).join(' and ')} office. ` : '';
const keywords = [
  { key: 'online', fit: ['it', 'bfsi', 'health', 'pharma'], h: `Online UPS in ${p.name}`, url: '/online-ups', link: 'Online UPS range',
    t: `Double-conversion online UPS from 1 to 1200 kVA, single and three phase, for ${labelsFor(['it', 'bfsi', 'health', 'pharma'], 'offices, server rooms and hospitals')} ${where}. Models run from Accenta (1–10 kVA) and Renata-I to Renata-300 and Renata Modular for N+1 redundancy.` },
  { key: 'industrial', fit: ['heavy', 'auto', 'textile', 'defence'], h: `Industrial UPS in ${p.name}`, url: '/industrial-ups-manufacturer-in-india', link: 'Industrial UPS range',
    t: `Industrial UPS from 10 to 800 kVA with built-in isolation transformers and IP41–IP55 enclosures, for ${labelsFor(['heavy', 'auto', 'textile', 'defence'], 'factories and process plants')} ${where}.` },
  { key: 'backup', fit: ['auto', 'textile', 'heavy'], h: `Power backup solutions in ${p.name}`, url: '/power-backup-solutions-manufacturer-in-india', link: 'Power backup solutions',
    t: `UPS, industrial inverters, servo voltage stabilizers and batteries (SMF, tubular, lithium and Ni-Cd) engineered as one backup system, sized to the connected load and backup time of each site in ${p.name}.` },
  { key: 'service', fit: [], h: `UPS service, AMC and per-call support in ${p.name}`, url: '/eandcpower-services', link: 'UPS service and AMC',
    t: `${serviceLine}Comprehensive and non-comprehensive AMC, per-call breakdown service, battery replacement and rental UPS, for E&C and other makes of UPS.` },
  { key: 'stabilizer', fit: ['auto', 'textile', 'heavy'], h: `Voltage stabilizers in ${p.name}`, url: '/stabilizer', link: 'Voltage stabilizers',
    t: `Servo voltage stabilizers, air cooled from 2 to 100 kVA and oil cooled from 100 to 1000 kVA, that hold machine and building supplies steady through voltage swings, for ${labelsFor(['auto', 'textile', 'heavy'], 'factories, hospitals and commercial buildings')} ${where}.` },
  { key: 'battery', fit: ['heavy'], h: `UPS batteries in ${p.name}`, url: '/ups-batteries', link: 'UPS and industrial batteries',
    t: `SMF, tubular, AGM / GEL, lithium ion and nickel cadmium batteries for UPS, inverters, solar and plant DC systems, supplied, installed and replaced in ${p.name} with the manufacturer's warranty and onsite support.` },
  { key: 'charger', fit: ['heavy'], h: `Industrial battery chargers in ${p.name}`, url: '/industrial-battery-charger-fcbc', link: 'Float cum boost chargers',
    t: `Float cum boost chargers at 48, 110 and 220 V DC for Ni-Cd and lead acid battery banks in substations, power plants, telecom and railways${fitKeys.includes('heavy') ? `, including ${labelsFor(['heavy'], '')} in ${p.name}` : ` in ${p.name}`}.` },
  { key: 'ev', fit: [], h: `EV chargers in ${p.name}`, url: '/ev-charger-manufacturer-in-india', link: 'EV chargers',
    t: `AC (3–22 kW) and DC (10–240 kW) EV chargers with CCS2, CHAdeMO and GB/T connectors, for office and commercial parking, fleets and charging operators in ${p.name}.` },
].map((k, i) => ({ ...k, score: k.fit.filter((s) => fitKeys.includes(s)).length, i }))
  .sort((a, b) => b.score - a.score || a.i - b.i);
// Title names the two biggest local keywords; shorter forms keep long city names within ~62 characters.
const title = [`${h1} | Online & Industrial UPS | E&C`, `${h1} | Online & Industrial UPS`, `${h1} | E&C Power`].find((t) => t.length <= 62) ?? h1;
schema[0].hasOfferCatalog = {
  '@type': 'OfferCatalog',
  name: `UPS products and services in ${p.name}`,
  itemListElement: keywords.map((k) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: k.h, url: urlFor(k.url.slice(1)) } })),
};
---
<Hub
  slug={p.slug}
  title={title}
  description={[`${h1}: online and industrial UPS, inverters and stabilizers for ${p.name}'s industries, from E&C Power Systems, a UPS manufacturer since 1978.`, `${h1}: online and industrial UPS, inverters and stabilizers from E&C Power Systems, Bengaluru, since 1978.`].find((d) => d.length <= 160)}
  name={h1}
  crumbs={crumbs}
  schema={schema}
  noindex={!indexable(p)}
>
  <section class="hb-hero">
    <div class="container">
      <div class="pd-wrap">
        <div>
          <span class="pd-eyebrow">{isCity ? `${parent ? parent.name : 'India'}, about ${km} km from our plant` : `${p.cities.length} cities in ${p.name}`}</span>
          <h1>{h1}</h1>
          <p class="hb-lead">{intro}</p>
          <ul class="pd-chips">
            {sectors.slice(0, 3).map((s) => <li><Icon name={s.icon} class="ic" />{s.label}</li>)}
          </ul>
          <div class="pd-ctas">
            <a class="pd-btn pd-btn-main" href="#quote">Get a price</a>
            <a class="pd-btn pd-btn-line" href="tel:+918028371974"><Icon name="fa-phone" class="ic" />080 2837 1974</a>
          </div>
        </div>
        <IndiaMap highlight={mapOn} labels={mapLabels} title={isCity ? `${p.name} and nearby cities, supplied from Bengaluru` : `Cities in ${p.name} supplied from Bengaluru`} />
      </div>
    </div>
  </section>

  <div class="container">
    <ul class="pd-trust">
      <li><Icon name="fa-check" class="ic" />UPS manufacturer since 1978</li>
      <li><Icon name="fa-industry" class="ic" />Designed and built in Peenya, Bengaluru</li>
      <li><Icon name="fa-truck" class="ic" />Supply, installation and AMC in {p.name}</li>
    </ul>
  </div>

  {isCity ? (
    <section class="pd-sec" aria-labelledby="h-areas">
      <div class="container">
        <h2 class="pd-h" id="h-areas">Power backup for {p.name}'s industrial areas</h2>
        <p class="hb-sub">Major industrial and business areas in {p.name}:</p>
        <ul class="hb-tags">{p.areas.map((a) => <li><span><Icon name="fa-map-marker" class="ic" /> {a}</span></li>)}</ul>
      </div>
    </section>
  ) : (
    <section class="pd-sec" aria-labelledby="h-cities">
      <div class="container">
        <h2 class="pd-h" id="h-cities">Cities we serve in {p.name}</h2>
        <div class="hb-cards three">
          {stateCities.map((c) => (
            <a class="hb-card" href={c.url}>
              <h3>UPS manufacturer in {c.name}</h3>
              <p>{c.km ? `About ${c.km} km from our Bengaluru plant` : 'Home of our plant in Peenya'}</p>
              <ul class="hb-tags">{(c.c ? c.c.areas.slice(0, 3) : ['Peenya', 'Electronic City', 'Whitefield']).map((a) => <li><span>{a}</span></li>)}</ul>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {local.power && (
    <section class="pd-sec alt" aria-labelledby="h-local">
      <div class="container">
        <h2 class="pd-h" id="h-local">Power conditions in {p.name}</h2>
        <p class="hb-p">{local.power}</p>
        <div class="hb-cards three">
          {local.needs.map((x) => (
            <div class="hb-card">
              <h3>{x.h}</h3>
              <p>{x.t}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="pd-sec" aria-labelledby="h-ind">
    <div class="container">
      <h2 class="pd-h" id="h-ind">UPS for {p.name}'s key industries</h2>
      <div class="hb-cards">
        {sectors.map((s) => (
          <div class="hb-card hb-ind">
            <span class="hb-ic"><Icon name={s.icon} class="ic" /></span>
            <h3>{s.label}</h3>
            <p>{s.need}</p>
            <p class="hb-rec">{s.links.map((l, i) => (<>{i > 0 && ' · '}<a href={l[1]}>{l[0]}</a></>))}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pd-sec" aria-labelledby="h-kw">
    <div class="container">
      <h2 class="pd-h" id="h-kw">UPS products and services in {p.name}</h2>
      <div class="hb-cards three">
        {keywords.map((k) => (
          <div class="hb-card">
            <h3>{k.h}</h3>
            <p>{k.t}</p>
            <p class="hb-rec"><a href={k.url}>{k.link}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pd-sec alt" aria-labelledby="h-range">
    <div class="container">
      <h2 class="pd-h" id="h-range">UPS and power backup range</h2>
      <Range slugs={range} />
      <p class="hb-p" style="margin-top:14px;">Also: <a href="/mil-grade">MIL grade UPS</a>, <a href="/smf">UPS batteries</a>, <a href="/industrial-battery-charger-fcbc">battery chargers</a>, <a href="/solar-solutions">solar systems</a> and <a href="/ev-chargers">EV chargers</a>. Not sure what size you need? Read <a href="/guides/ups-sizing-kva">how to size a UPS</a>.</p>
    </div>
  </section>

  <section class="pd-sec" aria-labelledby="h-svc">
    <div class="container">
      <h2 class="pd-h" id="h-svc">Supply, installation and service in {p.name}</h2>
      <ul class="hb-why">
        <li><Icon name="fa-industry" class="ic" /><span><strong>Built in Bengaluru</strong>Design, R&amp;D and manufacturing in Peenya Industrial Area, since 1978.</span></li>
        <li><Icon name="fa-truck" class="ic" /><span><strong>Delivered to your site</strong>All-India sales and service network, with over 1 lakh installations across India.</span></li>
        <li><Icon name="fa-cogs" class="ic" /><span><strong>Installed and commissioned</strong>By trained engineers, with load and battery checks at handover.</span></li>
        <li><Icon name="fa-wrench" class="ic" /><span><strong>Looked after</strong>AMC, battery replacement and breakdown service: see <a href="/eandcpower-services">UPS service and AMC</a>.</span></li>
        {p.facts.map((f) => <li><Icon name="fa-check" class="ic" /><span>{f}</span></li>)}
      </ul>
      {p.service && <p class="hb-p" style="margin-top:12px;">{p.service}</p>}
    </div>
  </section>

  {offices && <Offices {...offices} />}

  <section class="pd-sec" aria-labelledby="h-faq">
    <div class="container">
      <h2 class="pd-h" id="h-faq">Frequently asked questions</h2>
      <Faq faq={faq} />
    </div>
  </section>

  <section class="pd-sec alt" aria-labelledby="h-more">
    <div class="container">
      <h2 class="pd-h" id="h-more">{isCity ? 'Nearby locations' : 'More states'}</h2>
      <ul class="hb-tags">
        {isCity && p.nearby.map(cityLink).map((c) => <li><a href={c.url}>UPS manufacturer in {c.name}</a></li>)}
        {parent && <li><a href={`/${parent.slug}`}>UPS supplier in {parent.name}</a></li>}
        {others.map((x) => <li><a href={`/${x.slug}`}>UPS supplier in {x.name}</a></li>)}
        <li><a href="/ups-manufacturer-in-india">UPS manufacturer in India</a></li>
      </ul>
    </div>
  </section>

  <Quote title={`Get a UPS quotation for ${p.name}`} service={`Quote: UPS (${p.name})`} step1={`Share your load, backup time and site in ${p.name}`} />
</Hub>
